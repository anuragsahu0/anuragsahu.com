{
  "name": "anuragsahu.com",
  "private": true,
  "version": "2.0.0",
  "type": "commonjs",
  "scripts": {
    "dev": "vite",
    "version:bump": "node -e \"const fs=require('fs'); const file='./version.json'; const v=JSON.parse(fs.readFileSync(file, 'utf8')); const parts=v.version.split('.').map(Number); parts[2]++; v.version=parts.join('.'); fs.writeFileSync(file, JSON.stringify(v, null, 2) + '\\n'); if(fs.existsSync('./public/version.json')) fs.writeFileSync('./public/version.json', JSON.stringify(v, null, 2) + '\\n'); console.log('Version bumped to ' + v.version);\"",
    "build": "mkdir -p dist && cp -r index.html admin.html mobile.html AI-FINANCE-CONTROLLER.html app.js styles.css sw.js version.json manifest.json _headers .htaccess assets gta b data public dist/ 2>/dev/null || true",
    "predeploy": "npm run version:bump && npm run build",
    "lint": "eslint . --ext js,jsx --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "eslint . --ext js,jsx --fix",
    "format": "prettier --write \"src/**/*.{js,jsx,css,json,md}\"",
    "format:check": "prettier --check \"src/**/*.{js,jsx,css,json,md}\"",
    "preview": "vite preview"
  },
  "lint-staged": {
    "*.{js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,css,md}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@react-three/drei": "^9.105.0",
    "@react-three/fiber": "^8.16.0",
    "bcryptjs": "^2.4.3",
    "clsx": "^2.1.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.3.1",
    "express-validator": "^7.2.0",
    "framer-motion": "^11.0.8",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.354.0",
    "mongoose": "^8.4.1",
    "multer": "^2.3.0",
    "nodemailer": "^6.9.13",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.22.3",
    "tailwind-merge": "^2.2.1",
    "three": "^0.162.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.18",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react": "^7.34.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "husky": "^9.0.11",
    "lint-staged": "^15.2.2",
    "postcss": "^8.4.35",
    "prettier": "^3.2.5",
    "tailwindcss": "^3.4.1",
    "terser": "^5.29.0",
    "vite": "^5.1.6"
  }
}
